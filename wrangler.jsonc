{
  // This file tells Cloudflare Workers how to run our Next.js app.
  // The "main" points to the OpenNext worker entry point.
  "name": "mynclex-dev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  // Account pinning — by design, dev and prod live on different
  // Cloudflare accounts. Top-level account_id is the personal CF
  // account that owns mynclex-dev (and any other QAcademy front-
  // facing / non-prod things). env.prod.account_id is the workspace
  // CF account (qacademynurses) that owns paid prod Workers.
  //
  // Pinning these means wrangler refuses to deploy if the logged-in
  // CLI account doesn't match — it's the lock that prevents another
  // accidental "wrong account" deploy like 2026-04-29. The IDs are
  // identifiers, not secrets, so they're safe to commit.
  "account_id": "e745e37017141bd5dfa1183b5dc1aa48",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Public Supabase values — safe to commit. They ship to every browser
  // anyway (RLS is what protects the data, not these keys). The service
  // role key is NOT here — it's a Cloudflare Worker secret set via
  // `wrangler secret put SUPABASE_SERVICE_ROLE_KEY`.
  //
  // Top-level vars are the dev defaults. Prod values live in env.prod
  // below and are selected when the prod CF Worker deploys with the
  // wrangler environment set to `prod`.
  //
  // ⚠ THESE ARE RUNTIME BINDINGS ONLY, AND THAT IS NOT ENOUGH ON ITS OWN.
  // Cloudflare hands them to the Worker when it serves a request, which
  // covers every server-side read. But `NEXT_PUBLIC_*` is substituted into
  // the BROWSER bundle while `next build` runs, long before any binding
  // exists — so each value is ALSO listed in the `env:` block of the build
  // step in .github/workflows/deploy-dev.yml and deploy-prod.yml.
  // ⚠ Two places, one truth, nothing keeping them in step: change a public
  // value here and change it there too. (Found 2026-08-08 — until then the
  // browser bundle had no Supabase URL and no Turnstile key at all, so
  // /reset-password and /welcome could not work on either deployed
  // Worker.)
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://xkqxfzfsllxyxpdtcrja.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhrcXhmemZzbGx4eXhwZHRjcmphIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzcyMjk4ODYsImV4cCI6MjA5MjgwNTg4Nn0.yRC-HClidhjdUELZETOo9ndyKzzkV7k6Dn_QlyCjx9E",
    // Turnstile site key — public by design, it ships to every browser
    // that loads an auth form.
    //
    // ⭐⭐ DEV IS DELIBERATELY ON CLOUDFLARE'S *TESTING* PAIR, NOT THE REAL
    // DEV WIDGET. This is not a placeholder anyone forgot to fill in, and
    // it must not be "fixed" back to the real key without reading this.
    //
    // 1x00000000000000000000AA is published by Cloudflare for exactly this
    // purpose: a normal, visible widget that issues a pass instantly with
    // no challenge, paired with a secret whose answer is always yes. The
    // real dev widget was 0x4AAAAAAEKb3Z55nyB9Sipe (personal CF account,
    // hostnames mynclex-dev.mybackpacc.workers.dev + localhost) — keep it,
    // it is what we swap back to.
    //
    // ⭐ WHY: Turnstile's entire job is to stop an automated browser, and
    // it does it well, so a real widget locks Claude out of /login,
    // /register and /forgot-password — the three surfaces slice ③ is
    // about to rebuild. The testing pair keeps every step of the machinery
    // running (widget → pass → forwarded → Supabase validates → we read
    // the answer) and stubs out only the judgement. Settled 2026-08-09.
    //
    // ⚠ THIS IS A THREE-WAY MATCH AND ALL THREE MOVE TOGETHER: this key,
    // the same key in deploy-dev.yml, and the SECRET on the dev Supabase
    // project's captcha setting. A testing pass checked against the real
    // secret is refused, and so is the reverse — a mismatch is an outage
    // at the front door, not a degraded mode. Local dev is a fourth place
    // and lives in .env.local (both keys, see the note there).
    //
    // ⚠ PROD IS NOT THIS. Its real key sits in the `env.prod` block below,
    // on a different Cloudflare account, checked by a different Supabase
    // project. Never copy this line down there.
    //
    // ⓘ To exercise a genuine refusal on dev — the only practical way to
    // test the LOGIN_BLOCKED-vs-LOGIN_FAIL routing in lib/auth/turnstile.ts
    // — swap this for 2x00000000000000000000AB ("always fails") and the
    // dev Supabase secret for 2x0000000000000000000000000000000AA.
    // https://developers.cloudflare.com/turnstile/troubleshooting/testing/
    //
    // ⚠ Its partner, TURNSTILE_SECRET_KEY, is NOT here and must never be:
    // it is a Worker secret (`wrangler secret put`). If either is missing
    // at runtime the check switches itself off and says so loudly in the
    // Worker log — see lib/auth/turnstile.ts.
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  },
  "env": {
    "prod": {
      "name": "mynclex",
      "account_id": "38efec172a6a35b1928ffbd96003c21d",
      // The real front door — build-order item 4, attached 2026-08-09.
      //
      // `custom_domain: true` means wrangler does the whole job on deploy:
      // creates the DNS record on the zone and provisions the TLS
      // certificate. Nothing to add by hand in the dashboard.
      //
      // ⭐ THIS ONLY WORKS BECAUSE THE ZONE AND THE WORKER ARE ON THE SAME
      // CLOUDFLARE ACCOUNT. Cloudflare will not route a custom domain to a
      // Worker across accounts, which is exactly why quademia.com was
      // bought on the workspace account (38efec…) rather than the personal
      // one, back on 2026-08-05. See domain-and-identity.md → registration
      // checklist. If MyTeacher or the others ever attach their own
      // subdomain, they inherit the same constraint.
      //
      // ⚠ THE DEPLOY TOKEN NEEDS ZONE PERMISSION, NOT JUST WORKERS
      // PERMISSION. Creating a custom domain writes a DNS record, so
      // CLOUDFLARE_API_TOKEN_PROD (a repo secret, used by
      // deploy-prod.yml) must carry Zone → DNS → Edit on quademia.com as
      // well as Workers Scripts → Edit. If a release ever fails here with
      // an authorization error, that is the cause and the fallback is to
      // add the domain by hand in the dashboard (Workers → mynclex →
      // Settings → Domains & Routes) and drop this block.
      //
      // ⓘ Two doors are open on purpose right now: this one and the
      // default mynclex.qacademynurses.workers.dev. The workers.dev one
      // gets switched off (`"workers_dev": false`) once this is proven,
      // so the app answers on exactly one address — see the session log.
      "routes": [
        {
          "pattern": "nclex.quademia.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "NEXT_PUBLIC_SUPABASE_URL": "https://dehspjcfmhoshcdtsmjq.supabase.co",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRlaHNwamNmbWhvc2hjZHRzbWpxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzcyMzQ2MjEsImV4cCI6MjA5MjgxMDYyMX0.whd-VAiJLdsYT0VDfU1HhaxVvt1oeiHKxhhb7Vc1QbY",
        // The PROD widget — a different Cloudflare account (workspace),
        // hostnames mynclex.qacademynurses.workers.dev and
        // nclex.quademia.com (listed early, for build-order item 4).
        // ⚠ Its secret is a Worker secret on the prod Worker and has to be
        // set there before this deploys, or Turnstile is off in prod.
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAEKcS2eMshf8RS_u"
      }
    }
  }
}
